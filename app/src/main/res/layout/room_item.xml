<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@android:color/white"
    android:elevation="2dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/itemRoomNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Номер №101"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#212529" />

        <TextView
            android:id="@+id/itemRoomType"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Тип: Deluxe"
            android:textSize="14sp"
            android:textColor="#6C757D"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/itemMaxGuests"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Місткість: до 2 осіб"
            android:textSize="14sp"
            android:textColor="#6C757D" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/itemPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1200.00 $"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0D6EFD" />

        <TextView
            android:id="@+id/itemStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Вільний"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#198754"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>